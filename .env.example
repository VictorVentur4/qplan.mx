# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA debe subirse al repositorio.

# Cadena de conexión de Supabase / PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Clave para firmar los JWT. Usa una cadena larga y aleatoria en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Pon "disable" para un PostgreSQL local sin SSL. Supabase requiere "require".
DB_SSL=require

# Fase 2: permite que un dueño registre su propio negocio (nace inactivo).
ALLOW_BUSINESS_SELF_REGISTRATION=false

# Zona horaria con la que se cortan los días en los reportes de métricas.
REPORT_TIMEZONE=America/Mexico_City
